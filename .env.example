# FlowTalk Environment Configuration
# Copy this file to .env and fill in your API keys

# HuggingFace token for PyAnnote model access (required)
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Grradium Translation API key (required)
GRRADIUM_API_KEY=

# Optional: Custom Grradium API endpoint
# GRRADIUM_API_ENDPOINT=https://api.grradium.com/v1/translate
